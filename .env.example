LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_MODEL=hf:Qwen/Qwen2.5-7B-Instruct
LOCAL_LLM_API_KEY=
LOCAL_SAMPLE_COUNT=3
SAMPLE_TEMPERATURE=0.4
# One request returns all samples (vLLM n=) with the JSON schema enforced. false = old sequential mode.
BATCH_SAMPLES=true
AGREEMENT_THRESHOLD=0.8
LLM_TIMEOUT_SECONDS=90
ENABLE_LARGE_LOCAL=false
LARGE_LLM_BASE_URL=http://127.0.0.1:8001/v1
LARGE_LLM_MODEL=
LARGE_LLM_API_KEY=
ENABLE_CLOUD=false
CLOUD_LLM_BASE_URL=
CLOUD_LLM_MODEL=
CLOUD_LLM_API_KEY=
SIMULATION_MODE=false
EDGE_SUPPORT_API_URL=http://127.0.0.1:8502
EDGE_SUPPORT_API_HOST=127.0.0.1
EDGE_SUPPORT_API_PORT=8502
EDGE_SUPPORT_ACTION_TOKEN=
# Legacy app only; integrated router uses AGREEMENT_THRESHOLD.
CONFIDENCE_THRESHOLD=0.65
