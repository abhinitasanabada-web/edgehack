LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_MODEL=hf:Qwen/Qwen2.5-7B-Instruct
LOCAL_LLM_API_KEY=
LOCAL_SAMPLE_COUNT=3
SAMPLE_TEMPERATURE=0.4
# One request returns all samples (vLLM n=) with the JSON schema enforced. false = old sequential mode.
BATCH_SAMPLES=true
AGREEMENT_THRESHOLD=0.8
LLM_TIMEOUT_SECONDS=90
ENABLE_LARGE_LOCAL=false
LARGE_LLM_BASE_URL=http://127.0.0.1:8001/v1
LARGE_LLM_MODEL=
LARGE_LLM_API_KEY=
ENABLE_CLOUD=false
CLOUD_LLM_BASE_URL=
CLOUD_LLM_MODEL=
CLOUD_LLM_API_KEY=
SIMULATION_MODE=false
EDGE_SUPPORT_API_URL=http://127.0.0.1:8502
EDGE_SUPPORT_API_HOST=127.0.0.1
EDGE_SUPPORT_API_PORT=8502
EDGE_SUPPORT_ACTION_TOKEN=
# Legacy app only; integrated router uses AGREEMENT_THRESHOLD.
CONFIDENCE_THRESHOLD=0.65

# --- v2 enhancement switches. Blank/absent = original behaviour. scripts/run_matrix.sh sets them per run. ---
# Enum category/action IDs + required evidence in the enforced JSON schema (also used for sequential + cloud calls)
STRICT_SCHEMA=
# Drop the schema text from the prompt when the server already enforces it (shorter prompt)
COMPACT_PROMPT=
# any = one hedging/malformed sample vetoes (original) | majority = uncertainty needs half the samples; risk stays strict
GATE_MODE=
# Tolerate <think>, code fences, prose and common type slips in model JSON
LENIENT_PARSE=
# legacy (original) | bm25 = one ranked index over both corpora with unique kb:runbooks/... kb:knowledge/... IDs
RETRIEVAL=
# full (original) | keep_network = IP addresses reach the on-site model (diagnostic); every output stays fully redacted
LOCAL_REDACTION=
# Output cap per sample (default 700 batched / 1500 sequential); 450 is plenty for the schema
MAX_OUTPUT_TOKENS=
KB_TOP_K=
# Demo switch: behave as if the site uplink were down (cloud refused, answers still local)
FORCE_OFFLINE=
# Optional list prices (USD per 1M tokens) of YOUR cloud provider, for cost reporting in eval/evaluate.py
CLOUD_PRICE_IN_PER_MTOK=
CLOUD_PRICE_OUT_PER_MTOK=
